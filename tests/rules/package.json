{
  "name": "firestore-rules-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-stream-json-legacy-paths.cjs",
    "pretest": "node -e \"require('fs').copyFileSync('../../firestore.rules','./firestore.rules')\"",
    "pretest:load": "node -e \"require('fs').copyFileSync('../../firestore.rules','./firestore.rules')\"",
    "test": "firebase emulators:exec --only firestore --project demo-test \"node rules.test.mjs\"",
    "pretest:emulator": "node -e \"require('fs').copyFileSync('../../firestore.rules','./firestore.rules')\"",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-test \"node ../../functions/test/p0-approve-validation.emulator.test.js && node ../../functions/test/p0-approve-opportunity-concurrency.emulator.test.js && node document-hash-parity.emulator.test.mjs\"",
    "test:load": "firebase emulators:exec --only firestore --project demo-load \"node load-stress.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "qs": "^6.14.0",
    "csv-parse": "^7.0.2",
    "stream-json": "^3.6.0",
    "@opentelemetry/core": "^2.8.0"
  }
}
